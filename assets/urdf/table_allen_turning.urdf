    <visual>
      <material name="wood">
        <color rgba="0.82 0.56 0.35 1.0"/>
      </material>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.450 0.380 0.300"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
