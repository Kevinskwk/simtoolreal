<?xml version="1.0"?>
<robot name="allen_disabled_table">
  <!-- SimToolReal requires a table rigid body. Keep an invisible placeholder
       below the workspace; the Allen socket is explicitly fixture-held. -->
  <link name="box">
    <visual>
      <geometry><box size="0.001 0.001 0.001"/></geometry>
      <material name="invisible"><color rgba="0 0 0 0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.01 0.01 0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
</robot>
